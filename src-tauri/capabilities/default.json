{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*/*" },
        { "url": "https://*/*" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true }
      ]
    },
    "shell:allow-open",
    "dialog:default",
    "websocket:default",
    "updater:default",
    "process:allow-restart",
    "allow-kapi-write-text-file",
    "allow-kapi-write-binary-file",
    "allow-kapi-read-text-file",
    "allow-kapi-path-exists",
    "allow-kapi-mock-start",
    "allow-kapi-mock-stop",
    "allow-kapi-mock-is-running",
    "allow-kapi-claude-prompt",
    "allow-kapi-claude-available",
    "allow-kapi-open-discovery",
    "allow-kapi-oauth-listen",
    "allow-kapi-oauth-cancel",
    "allow-kapi-send-mtls",
    "allow-kapi-ai-list-available",
    "allow-kapi-ai-prompt"
  ]
}
