{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {"name": "git-rev-parse", "cmd": "git", "args": ["rev-parse", "--is-inside-work-tree"]},
        {"name": "git-init", "cmd": "git", "args": ["init"]},
        {"name": "git-remote", "cmd": "git", "args": ["remote"]},
        {"name": "git-remote-add", "cmd": "git", "args": ["remote", "add", "origin", {"validator": "(https://|ssh://|git@)[^\\s\\-][^\\s]*"}]},
        {"name": "git-status", "cmd": "git", "args": ["status", "--porcelain"]},
        {"name": "git-diff", "cmd": "git", "args": ["diff", "--", "."]},
        {"name": "git-diff-untracked", "cmd": "git", "args": ["diff", "--no-index", "--", "/dev/null", {"validator": "[^\\n\\r]+"}]},
        {"name": "git-add", "cmd": "git", "args": ["add", "-A"]},
        {"name": "git-commit", "cmd": "git", "args": ["commit", "-m", {"validator": "(?s).+"}]},
        {"name": "git-push", "cmd": "git", "args": ["push", "-u", "origin", "HEAD"]},
        {"name": "git-pull", "cmd": "git", "args": ["pull"]},
        {"name": "git-log", "cmd": "git", "args": ["log", {"validator": "-[0-9]{1,4}"}, "--pretty=format:%h\u001f%s\u001f%ar\u001e"]},
        {"name": "git-branch", "cmd": "git", "args": ["branch", "--show-current"]}
      ]
    },
    "shell:allow-open",
    "dialog:default",
    "websocket:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "notification:default",
    "core:window:allow-destroy",
    "allow-kapi-write-text-file",
    "allow-kapi-write-binary-file",
    "allow-kapi-read-text-file",
    "allow-kapi-path-exists",
    "allow-kapi-mock-start",
    "allow-kapi-mock-stop",
    "allow-kapi-mock-is-running",
    "allow-kapi-open-discovery",
    "allow-kapi-oauth-listen",
    "allow-kapi-oauth-cancel",
    "allow-kapi-send-mtls",
    "allow-kapi-ai-list-available",
    "allow-kapi-ai-prompt",
    "allow-kapi-secrets-key",
    "allow-kapi-grpc-load-protos",
    "allow-kapi-grpc-reflect",
    "allow-kapi-grpc-call",
    "allow-kapi-grpc-cancel",
    "allow-kapi-resolve-secret-ref",
    "allow-kapi-secret-ref-approvals",
    "allow-kapi-secret-ref-revoke",
    "allow-kapi-mqtt-connect",
    "allow-kapi-mqtt-subscribe",
    "allow-kapi-mqtt-unsubscribe",
    "allow-kapi-mqtt-publish",
    "allow-kapi-mqtt-disconnect"
  ]
}
